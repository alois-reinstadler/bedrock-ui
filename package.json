{
	"name": "bedrock-ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.24.0",
	"scripts": {
		"dev": "NODE_ENV=development vite dev",
		"build": "pnpm run reference:generate && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "NODE_ENV=test vitest",
		"test": "pnpm run test:unit --run && pnpm run test:e2e",
		"test:e2e": "playwright test --grep-invert @remote-media",
		"test:e2e:media": "playwright test --grep @remote-media",
		"reference:generate": "node scripts/extract-component-reference.mjs",
		"motion:verify": "node scripts/verify-motion-package.mjs",
		"assets:verify": "node scripts/verify-template-media.mjs",
		"test:e2e:agent": "e2e run"
	},
	"devDependencies": {
		"@ai-sdk/openai-compatible": "3.0.53",
		"@axe-core/playwright": "^4.13.0",
		"@e2e-dev/web": "0.12.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.34.0",
		"@paper-design/shaders": "0.0.81",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "next",
		"@sveltejs/kit": "3.0.0-next.25",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/svelte-table": "^9.2.4",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^24",
		"@types/opentype.js": "1.3.10",
		"@types/qrcode": "1.5.6",
		"@vitest/browser-playwright": "^4.1.8",
		"ai": "7.0.107",
		"astra-motion": "file:vendor/astra-motion-0.1.0-rc.3-c7a0c1aac16f.tgz",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"diff": "^9.0.0",
		"e2e": "0.17.0",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"formsnap": "^2.0.1",
		"globals": "^17.6.0",
		"layerchart": "^2.3.1",
		"libphonenumber-js": "1.13.14",
		"maplibre-gl": "6.7.0",
		"marked": "^18.0.11",
		"mdsvex": "^0.12.7",
		"mode-watcher": "^1.1.0",
		"opentype.js": "2.0.0",
		"paneforge": "^1.0.2",
		"pdfjs-dist": "^6.3.289",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"qrcode": "1.5.4",
		"shadcn-svelte": "^1.5.1",
		"shiki": "^4.4.3",
		"svelte": "^5.57.0",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"zod": "4.6.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/utils.js": "./src/lib/utils.ts",
		"#lib/bedrock/ui/map/lazy": "./src/lib/bedrock/ui/map/lazy.ts",
		"#lib/bedrock/ui/*": "./src/lib/bedrock/ui/*/index.ts",
		"#lib/components/ui/*": "./src/lib/shadcn/ui/*",
		"#lib/hooks/*": "./src/lib/shadcn/hooks/*",
		"#lib/site/examples": "./src/lib/site/examples.ts",
		"#lib/site/registry": "./src/lib/site/registry.ts",
		"#lib/*": "./src/lib/*"
	}
}
